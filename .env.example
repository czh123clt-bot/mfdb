# DOUBAO_ARK_API_KEY: Doubao / Volcengine Ark API key for image editing/inpainting.
DOUBAO_ARK_API_KEY="your_doubao_ark_api_key_here"

# DOUBAO_MODEL_ENDPOINT: Doubao Ark model endpoint ID (e.g., ep-2024xxxxxx-xxxxx) or model name
DOUBAO_MODEL_ENDPOINT="ep-20241201-xxxx"

# GEMINI_API_KEY: Required for fallback or secondary processing if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
